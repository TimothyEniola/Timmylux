generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  DISPATCHED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String
  name             String
  phone            String?
  role             Role         @default(CUSTOMER)
  isVerified       Boolean      @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  orders           Order[]
  cartItems        CartItem[]
  wishlistItems    Wishlist[]
  createdAt        DateTime     @default(now())
}

model Product {
  id             String         @id @default(uuid())
  name           String
  category       String
  collection     String?
  price          Float
  originalPrice  Float?
  description    String?
  featured       Boolean        @default(false)
  featuredExpiry DateTime?
  available      Boolean        @default(true)
  images         String[]
  variations     Variation[]
  cartItems      CartItem[]
  wishlistItems  Wishlist[]
  createdAt      DateTime       @default(now())
}

model Variation {
  id        String     @id @default(uuid())
  productId String
  name      String
  price     Float?
  color     String?
  material  String?
  image     String?
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  totalAmount   Float
  status        OrderStatus   @default(PENDING)
  paymentMethod String
  paymentStatus PaymentStatus @default(PENDING)
  paystackRef   String?       @unique
  items         OrderItem[]
  user          User          @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId      String
  productName    String   @default("Furniture item")
  variationId    String?
  quantity       Int
  priceAtBuy     Float
  isMadeToOrder  Boolean  @default(false)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CartItem {
  id          String     @id @default(uuid())
  userId      String
  productId   String
  variationId String?
  quantity    Int        @default(1)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation   Variation? @relation(fields: [variationId], references: [id])
  
  @@unique([userId, productId, variationId])
}

model Wishlist {
  id        String  @id @default(uuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([userId, productId])
}

model Coupon {
  id         String   @id @default(uuid())
  code       String   @unique
  discount   Float
  type       String
  expiryDate DateTime
  active     Boolean  @default(true)
}

model Event {
  id                 String   @id @default(uuid())
  title              String
  description        String
  type               String
  startTime          String?
  endTime            String?
  startDate          DateTime?
  endDate            DateTime?
  location           String?
  image              String?
  isActive           Boolean  @default(true)
  gameEnabled              Boolean  @default(false)
  branchEnabled            Boolean  @default(false)
  participatingLocationIds String[] @default([])
  participatingLocations   Json?
  ticketPrice              Float?
  ticketPrizes             Json?
  discountPercentage       Float?
  promoCode          String?
  maxAttendees       Int?
  contactInfo        String?
  targetUrl          String?
  tickets            EventTicket[]
}

model EventTicket {
  id            String   @id @default(uuid())
  eventId       String
  number        String
  prize         String
  customerName  String
  customerEmail String
  customerPhone String?
  amount        Int
  paymentMethod String
  status        String   @default("RESERVED")
  reference     String?
  expiresAt     DateTime?
  branchId      String?
  branchName    String?
  createdAt     DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, number])
  @@index([reference])
  @@index([eventId, status, expiresAt])
}

model AcademyApplication {
  id           String   @id @default(uuid())
  fullName     String
  email        String
  phone        String
  experience   String?
  motivation   String
  availability String
  status       String   @default("pending")
  submittedAt  DateTime @default(now())
}

model CustomRequestSubmission {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  roomType    String?
  topic       String?
  address     String?
  description String
  budget      String?
  imageUrls   String[] @default([])
  read        Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([submittedAt])
}